                /*%FSM<STATE "load_dlc_informa">*/
                class load_dlc_informa
                {
                        name = "load_dlc_informa";
                        itemno = 27;
                        init = /*%FSM<STATEINIT""">*/"// Collect all CfgPatches dependencies so that client knows what's available on server" \n
                         "private _loadedPatches = [];" \n
                         "private _factions = ""true"" configClasses (configFile >> ""A3A"" >> ""Templates"");" \n
                         "private _addonVics = ""true"" configClasses (configFile >> ""A3A"" >> ""AddonVics"");" \n
                         "{" \n
                         "    {" \n
                         "        if (isClass (configFile >> ""CfgPatches"" >> _x)) then { _loadedPatches pushBackUnique _x };" \n
                         "    } forEach getArray(_x >> ""requiredAddons"");" \n
                         "} forEach (_factions + _addonVics);" \n
                         "" \n
                         "// Ignore DLC without equipment and vehicles" \n
                         "// Need the true names from here, so pass it all in" \n
                         "// Arma bug: Need to hardcode CDLC because arma3.cfg mod loading method doesn't register CDLC as ""official""" \n
                         "private _loadedDLC = getLoadedModsInfo select { (_x#2) and !(_x#1 in [""A3"",""curator"",""argo"",""tacops""]) };" \n
                         "_loadedDLC append (getLoadedModsInfo select { tolower (_x#1) in [""ef"", ""gm"", ""rf"", ""spe"", ""vn"", ""ws"", ""csla""] });" \n
                         "" \n
                         "_platform = productVersion select 6;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
