*//*%FSM</HEAD>*/
class FSM
{
        fsmName = "a3ue-init-setup-monitor";
        class States
        {
                /*%FSM<STATE "Game_Setup_Monit">*/
                class Game_Setup_Monit
                {
                        name = "Game_Setup_Monit";
                        itemno = 0;
                        init = /*%FSM<STATEINIT""">*/"private[""_addonVics"",""_adminLoopPriority"",""_autoLoadData"",""_autoLoadTime"",""_factions"",""_loadedDLC"",""_loadedPatches"",""_loopDelay"",""_platform"",""_waitState""];" \n
                         "private _gsmSetupOkay = false;" \n
                         "private _defineFunc = {" \n
                         "    if !assert(params[" \n
                         "        [""_name"", nil, [""""]]," \n
                         "        [""_code"", nil, [{}, """"]]" \n
                         "    ]) throw ""invalid parameters"";" \n
                         "" \n
                         "    if (!isNil { missionNamespace getVariable _name }) throw format[""function %1 is not supposed to exist."", _name];" \n
                         "    if (_code isEqualType {}) exitWith {" \n
                         "        missionNamespace setVariable[_name, _code];" \n
                         "    };" \n
                         "" \n
                         "    private _pcode = preprocessFileLineNumbers _code;" \n
                         "    if (_pcode isEqualTo """") throw format[""failed to load """"%1"""""", _code];" \n
                         "    missionNamespace setVariable[_name, compileFinal _pcode];" \n
                         "};" \n
                         "private _log = {" \n
                         "    private _p = [[_this], _this] select(_this isEqualType []);" \n
                         "    diag_log text format[""[a3a-game-setup-monitor] %1"", format _p];" \n
                         "    nil;" \n
                         "};" \n
                         "private _badlog = {" \n
                         "    private _p = [[_this], _this] select(_this isEqualType []);" \n
                         "    _p set[0, format[""A3A-BAD-INIT: %1"", _p select 0]];" \n
                         "    _p call _log;" \n
                         "};" \n
                         "" \n
                         "A3A_setupPlayer = objNull;" \n
                         """FSM start"" call _log;" \n
                         "" \n
                         "try {" \n
                         "    [""A3A_core_fnc_isValidAdmin"", {" \n
                         "        (admin owner _this == 2) ||                // non-voted admin on DS" \n
                         "        {hasInterface && {_this isEqualTo player}} // localhost. returns admin owner _this = 0 for some reason" \n
                         "    }] call _defineFunc;" \n
                         "    [""A3A_core_fnc_loadExtenders"", ""\x\a3a\addons\core\functions\init\fn_initExtenderDetection.sqf""] call _defineFunc;" \n
                         "    [""A3A_core_fnc_validateExtenderCompat"", ""\x\a3a\addons\core\functions\init\fn_validateExtenderCompat.sqf""] call _defineFunc;" \n
                         "" \n
                         "	_gsmSetupOkay = true;" \n
                         "} catch {" \n
                         "    [""game setup monitor caught exception: %1"", _exception] call _badlog;" \n
                         "};" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 2;
                                        priority = 1.000000;
                                        to="bad_init";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"isNil ""_gsmSetupOkay"" || {!_gsmSetupOkay}" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "__1">*/
                                class __1
                                {
                                        itemno = 6;
                                        priority = 0.000000;
                                        to="load_dlc_informa";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "Done">*/
                class Done
                {
                        name = "Done";
                        itemno = 1;
                        init = /*%FSM<STATEINIT""">*/"""exiting game setup monitor normally."" call _log;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "bad_init">*/
                class bad_init
                {
                        name = "bad_init";
                        itemno = 3;
                        init = /*%FSM<STATEINIT""">*/"""Bad init state reached."" call _log;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 4;
                                        priority = 0.000000;
                                        to="End_mission";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "End_mission">*/
                class End_mission
                {
                        name = "End_mission";
                        itemno = 5;
                        init = /*%FSM<STATEINIT""">*/"""Ending missing prematurely"" call _log;" \n
                         "" \n
                         "[""A3A_core_endMissionBadInit"", false, 2] remoteExec[""BIS_fnc_endMission""];" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "read_extenders">*/
                class read_extenders
                {
                        name = "read_extenders";
                        itemno = 7;
                        init = /*%FSM<STATEINIT""">*/"""Looking for extenders..."" call _log;" \n
                         "" \n
                         "[] call A3A_core_fnc_loadExtenders;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 9;
                                        priority = 2.000000;
                                        to="bad_init";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"(isNil ""A3A_core_extendersLoaded"") || {isNil ""A3A_core_extendersLoadedInvalid""};" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"""failed to find gvars"" call _badlog;" \n
                                         ""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "__1">*/
                                class __1
                                {
                                        itemno = 10;
                                        priority = 1.000000;
                                        to="deny_auto_start";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"A3A_core_extendersLoadedInvalid isNotEqualTo []" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "__2">*/
                                class __2
                                {
                                        itemno = 8;
                                        priority = 0.000000;
                                        to="get_auto_start_s";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "allow_auto_start">*/
                class allow_auto_start
                {
                        name = "allow_auto_start";
                        itemno = 11;
                        init = /*%FSM<STATEINIT""">*/"""Searching for suitable saves for automatic loading"" call _log;" \n
                         "" \n
                         "private _validFactions = _factions select { getArray(_x >> ""requiredAddons"") findIf { !(_x in _loadedPatches) } == -1 } apply { configName _x };" \n
                         "private _validAddons = _addonVics select { getArray(_x >> ""requiredAddons"") findIf { !(_x in _loadedPatches) } == -1 } apply { configName _x };" \n
                         "private _validDLC = _loadedDLC apply {_x#1};" \n
                         "" \n
                         "private _fnc_isValidSave = {" \n
                         "    if (_this get ""map"" != worldName) exitWith {false};" \n
                         "    if (!isNil {_this get ""ended""}) exitWith {false};" \n
                         "    if (isNil {_this get ""factions""}) exitWith {false};" \n
                         "    if (_this get ""factions"" findIf { !(_x in _validFactions) } != -1) exitWith {false};" \n
                         "    if (_this get ""addonVics"" findIf { !(_x in _validAddons) } != -1) exitWith {false};" \n
                         "    if (_this get ""DLC"" findIf { !(_x in _validDLC) } != -1) exitWith {false};" \n
                         "    true;" \n
                         "};" \n
                         "" \n
                         "private _saveData = call A3A_fnc_collectSaveData;" \n
                         "private _index = _saveData findIf { _x call _fnc_isValidSave };" \n
                         "" \n
                         "if (_index == -1) then {" \n
                         "    ""No usable saves found for automatic loading"" call _log;" \n
                         "    _autoLoadTime = -1;" \n
                         "} else {" \n
                         "    _autoLoadData = _saveData select _index;" \n
                         "    _autoLoadData set [""startType"", ""load""];" \n
                         "    [""save ID %1 selected for automatic loading"", _autoLoadData get ""gameID""] call _log;" \n
                         "    _autoLoadTime = diag_tickTime + _autoLoadTime;" \n
                         "" \n
                         "    _waitState = ""autostartwait"";" \n
                         "};" \n
                         "" \n
                         "[""autoLoadTime is %1"", _autoLoadTime] call _log;" \n
                         ""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "_">*/
                                class _
                                {
                                        itemno = 14;
                                        priority = 0.000000;
                                        to="enter_setup_loop";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                        };
                };
                /*%FSM</STATE>*/
                /*%FSM<STATE "main_game_setup">*/
                class main_game_setup
                {
                        name = "main_game_setup";
                        itemno = 12;
                        init = /*%FSM<STATEINIT""">*/""/*%FSM</STATEINIT""">*/;
                        precondition = /*%FSM<STATEPRECONDITION""">*/""/*%FSM</STATEPRECONDITION""">*/;
                        class Links
                        {
                                /*%FSM<LINK "save_game_data_l">*/
                                class save_game_data_l
                                {
                                        itemno = 18;
                                        priority = 100.000000;
                                        to="start_game";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"!(isNil ""A3A_saveData"");" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "find_admin_for_s">*/
                                class find_admin_for_s
                                {
                                        itemno = 15;
                                        priority = 95.000000;
                                        to="main_game_setup";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"call {" \n
                                         "    if (isNull A3A_setupPlayer) exitWith {" \n
                                         "        private _players = allPlayers - entities ""HeadlessClient_F"";" \n
                                         "        private _adminIndex = _players findIf { _x call A3A_core_fnc_isValidAdmin };" \n
                                         "" \n
                                         "        if (_adminIndex >= 0) then {" \n
                                         "            A3A_setupPlayer = _players select _adminIndex;" \n
                                         "            [""Player %1 is now admin, sending them the save data"", name A3A_setupPlayer] call _log;" \n
                                         "            A3A_startupState = ""adminsetup""; publicVariable ""A3A_startupState"";" \n
                                         "        };" \n
                                         "" \n
                                         "        false;" \n
                                         "    };" \n
                                         "" \n
                                         "    if (A3A_setupPlayer call A3A_core_fnc_isValidAdmin) exitWith { false };" \n
                                         "" \n
                                         "    [""Player %1 is no longer admin, disabling their setup dialog"", name A3A_setupPlayer] call _log;" \n
                                         "    A3A_startupState = _waitState; publicVariable ""A3A_startupState"";" \n
                                         "    A3A_setupPlayer setVariable[""A3A_core_hasSetupDialog"", nil];" \n
                                         "" \n
                                         "    [""serverClose""] remoteExec[""A3A_fnc_setupDialog"", A3A_setupPlayer];" \n
                                         "    A3A_setupPlayer = objNull;" \n
                                         "" \n
                                         "    true;" \n
                                         "};" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"_adminLoopPriority = 95;" \n
                                         ""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "show_extender_wa">*/
                                class show_extender_wa
                                {
                                        itemno = 29;
                                        priority = 90.000000;
                                        to="main_game_setup";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"call {" \n
                                         "    if (_adminLoopPriority <= 90) exitWith { false };" \n
                                         "    if (isNull A3A_setupPlayer) exitWith { false };" \n
                                         "    if (A3A_core_extendersLoadedInvalid isEqualTo []) exitWith { false };" \n
                                         "" \n
                                         "    // GVAR not set on player; set it and send GVARs + dialog exec request" \n
                                         "    if (isNil {A3A_setupPlayer getVariable ""A3A_core_confirmedExtenderWarnings""}) exitWith {" \n
                                         "        [""Opening extender warning dialog for """"%1"""""", name A3A_setupPlayer] call _log;" \n
                                         "" \n
                                         "        A3A_setupPlayer setVariable[""A3A_core_confirmedExtenderWarnings"", false, [2, owner A3A_setupPlayer]];" \n
                                         "        missionNamespace setVariable[""A3A_core_extendersLoaded"", A3A_core_extendersLoaded, owner A3A_setupPlayer];" \n
                                         "        missionNamespace setVariable[""A3A_core_extendersLoadedInvalid"", A3A_core_extendersLoadedInvalid, owner A3A_setupPlayer];" \n
                                         "" \n
                                         "        [{ [] remoteExec[A3A_fnc_setupCheckExtenders, owner A3A_setupPlayer] }] call CBA_fnc_execNextFrame;" \n
                                         "" \n
                                         "        false;" \n
                                         "    };" \n
                                         "" \n
                                         "    if (A3A_setupPlayer getVariable ""A3A_core_confirmedExtenderWarnings"") exitWith { false };" \n
                                         "" \n
                                         "    true;" \n
                                         "};" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"// SIC! Need to skip prio 85 here if condition returns true" \n
                                         "_adminLoopPriority = 80;" \n
                                         ""/*%FSM</ACTION""">*/;
                                };
                                /*%FSM</LINK>*/
                                /*%FSM<LINK "show_setup_dialo">*/
                                class show_setup_dialo
                                {
                                        itemno = 17;
                                        priority = 85.000000;
                                        to="main_game_setup";
                                        precondition = /*%FSM<CONDPRECONDITION""">*/""/*%FSM</CONDPRECONDITION""">*/;
                                        condition=/*%FSM<CONDITION""">*/"call {" \n
                                         "    if (_adminLoopPriority <= 85) exitWith { false };" \n
                                         "    if (isNull A3A_setupPlayer) exitWith { false };" \n
                                         " " \n
                                         "    if (isNil { A3A_setupPlayer getVariable ""A3A_core_hasSetupDialog"" }) exitWith { true };" \n
                                         "" \n
                                         "    false;" \n
                                         "};" \n
                                         ""/*%FSM</CONDITION""">*/;
                                        action=/*%FSM<ACTION""">*/"""[act] show-setup-dlg"" call _log;" \n
                                         "_adminLoopPriority = 85;" \n
                                         "" \n
                                         "A3A_setupPlayer setVariable[""A3A_core_hasSetupDialog"", true];" \n
                                         "" \n
                                         "private _saveData = call A3A_fnc_collectSaveData;" \n
                                         "" \n
